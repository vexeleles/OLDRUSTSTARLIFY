# Переменные окружения для хостинга (добавьте их в настройках хоста, файл .env не заливайте)
BOT_TOKEN=
CRYPTO_BOT_TOKEN=
ADMIN_IDS=
# Адрес сайта магазина (https://...). На Render/Railway определяется сам, на других хостах укажите вручную:
SHOP_WEBAPP_URL=
# Обязательная подписка на канал (необязательно). Бот должен быть админом канала:
REQUIRED_CHANNEL=
